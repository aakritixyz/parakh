# Parakh local development settings.
# Copy this file to .env. Never commit .env.

APP_NAME=Parakh

# dev | test | production. Production refuses unsafe demo credentials.
ENV=dev

# Change this before sharing a server. Use a long random value.
SECRET_KEY=change-me-in-production

# SQLite is fine for local demos. PostgreSQL is the production target.
DATABASE_URL=sqlite:///./parakh.db
USE_SQLITE=true

# Content-addressed evidence store. Originals are immutable.
STORAGE_ROOT=./data/storage
RETENTION_DAYS=365

# Browser/frontend origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Auth/demo bootstrap.
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_ADMIN_USERNAME=admin
# Dev only fallback is admin123. Set this explicitly for your demo.
DEMO_ADMIN_PASSWORD=admin123

# Offline-first AI defaults. "stub" means labelled/non-generative fallback.
LOCAL_LLM_PROVIDER=stub
EMBEDDING_PROVIDER=local-hash

# INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO
