# Parakh local development settings.
# Copy this file to .env. Never commit .env.

APP_NAME=Parakh

# dev | test | production. Production refuses unsafe demo credentials.
ENV=dev

# Change this before sharing a server. Use a long random value.
SECRET_KEY=change-me-in-production

# SQLite is fine for local demos. PostgreSQL is the production target.
DATABASE_URL=sqlite:///./parakh.db
USE_SQLITE=true

# Content-addressed evidence store. Originals are immutable.
STORAGE_ROOT=./data/storage
RETENTION_DAYS=365
# Intake safety limits. Values are bytes except member count and ratio.
MAX_UPLOAD_BYTES=536870912
MAX_ZIP_MEMBERS=1000
MAX_ZIP_UNCOMPRESSED_BYTES=1073741824
MAX_ZIP_RATIO=100

# Browser/frontend origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Auth/demo bootstrap.
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_ADMIN_USERNAME=admin
# Required before seeding in every environment. No implicit password.
# Set this in your private .env; never put it in VITE_* browser variables.
DEMO_ADMIN_PASSWORD=

# Offline inference only. Provision weights explicitly; missing models use labelled fallback.
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11436
EMBEDDING_PROVIDER=multilingual-e5-small

# Offset-less WhatsApp timestamps: match the source device's export settings.
WHATSAPP_TIMEZONE=Asia/Kolkata
WHATSAPP_DAY_FIRST=true

# INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO
