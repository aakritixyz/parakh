{
  "name": "parakh-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint . && node scripts/check-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:screenshots": "node scripts/screenshots.mjs",
    "test": "node --test scripts/api.test.mjs scripts/board.test.mjs scripts/casework.test.mjs scripts/map-layout.test.mjs scripts/session.test.mjs",
    "test:board-performance": "node scripts/board.performance.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.19",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7"
  }
}
